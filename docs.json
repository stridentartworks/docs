{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Developer Platform",
  "colors": {
    "primary": "#966EFB",
    "light": "#966EFB",
    "dark": "#190936"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "href": "docs/introduction"
      },
      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.yaml"
      }
    ],
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "docs/introduction",
          "docs/quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "/docs/introduction",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://blog.urun.sh/",
          "icon": "newspaper"
        }
      ]
    }
  },
  "api" : {
    "openapi": {
      "source": "openapi.yaml",
      "directory": "api-reference"
    },
    "examples": {
      "languages": ["bash", "python", "javascript"]
    }
  },
  "logo": {
    "light": "/logo/urunml_logo.jpeg",
    "dark": "/logo/urunml_logo.jpeg"
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://blog.urun.sh/"
      },
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "background": {
    "decoration": "gradient"
  },
  "icons": {
    "library": "fontawesome"
  },
  "fonts": {
    "family": "Railway"
  },
  "errors": {
    "404": {
      "title": "Page Not Found",
      "description": "Please check the URL or return to the [homepage](/).",
      "redirect": false
    }
  },
  "footer": {
    "socials": {
      "discord": "https://discord.com/invite/QN5crJRE7C",
      "linkedin": "https://linkedin.com/company/urunml",
      "bluesky": "https://bsky.app/profile/urunml.bsky.social"
    }
  }
}