{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Diane Diaz",
  "colors": {
    "primary": "#0E0E0E",
    "light": "#D4A27F",
    "dark": "#0E0E0E"
  },
  "favicon": "favicon.png",
  "appearance": {
    "default": "dark"
  },
  "navigation": {
    "pages": [
      "index"
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude"
    ]
  },
  "icons": {
    "library": "fontawesome"
  },
  "fonts": {
    "heading": {
      "family": "Radley"
    },
    "body": {
      "family": "Anthropic Sans"
    }
  },
  "errors": {
    "404": {
      "title": "Page Not Found",
      "description": "Please check the URL or return to the [homepage](/).",
      "redirect": false
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/AnthropicAI",
      "linkedin": "https://www.linkedin.com/company/anthropicresearch"
    }
  }
}