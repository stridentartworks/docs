{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Developer Platform",
  "colors": {
    "primary": "#966EFB",
    "light": "#966EFB",
    "dark": "#190936"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "docs/introduction",
              "docs/quickstart",
              "docs/features"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "docs/input",
              "docs/assets"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "docs/faqs",
              "docs/best-practices",
              "docs/troubleshooting",
              "docs/get-help"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "openapi": "api-reference/openapi.yaml"
      }
    ]
  },
  "api" : {
    "openapi": {
      "source": "api-reference/openapi.yaml",
      "directory": "api-reference"
    },
    "examples": {
      "languages": ["bash", "python", "javascript"]
    }
  },
  "logo": {
    "light": "/logo/urunml_logo.jpeg",
    "dark": "/logo/urunml_logo.jpeg"
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://blog.urun.sh/"
      },
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "background": {
    "decoration": "gradient"
  },
  "icons": {
    "library": "fontawesome"
  },
  "fonts": {
    "family": "Railway"
  },
  "errors": {
    "404": {
      "title": "Page Not Found",
      "description": "Please check the URL or return to the [homepage](/).",
      "redirect": false
    }
  },
  "footer": {
    "socials": {
      "discord": "https://discord.com/invite/QN5crJRE7C",
      "linkedin": "https://linkedin.com/company/urunml",
      "bluesky": "https://bsky.app/profile/urunml.bsky.social"
    }
  }
}